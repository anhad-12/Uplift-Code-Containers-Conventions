[
  {
    "id": "basesettings-moved",
    "title": "BaseSettings moved to pydantic-settings package",
    "kind": "api_removed",
    "guideSection": "BaseSettings has moved to pydantic-settings",
    "detect": {"type": "import", "pattern": "from pydantic import BaseSettings"},
    "replacement": "from pydantic_settings import BaseSettings  (after: pip install pydantic-settings)"
  },
  {
    "id": "config-class-deprecated",
    "title": "Inner class Config is deprecated; use model_config = ConfigDict(...) instead",
    "kind": "syntax",
    "guideSection": "Changes to config",
    "detect": {"type": "regex", "pattern": "^\\s+class Config:"},
    "replacement": "model_config = ConfigDict(...)"
  },
  {
    "id": "orm-mode-renamed",
    "title": "Config key orm_mode renamed to from_attributes",
    "kind": "api_changed",
    "guideSection": "Changes to config",
    "detect": {"type": "identifier", "pattern": "orm_mode"},
    "replacement": "from_attributes = True  (inside ConfigDict)"
  },
  {
    "id": "validator-deprecated",
    "title": "@validator is deprecated; replace with @field_validator",
    "kind": "api_changed",
    "guideSection": "@validator and @root_validator are deprecated",
    "detect": {"type": "import", "pattern": "from pydantic import.*validator"},
    "replacement": "from pydantic import field_validator"
  },
  {
    "id": "validator-each-item",
    "title": "@validator each_item=True not supported in @field_validator; use Annotated item type instead",
    "kind": "api_changed",
    "guideSection": "@validator and @root_validator are deprecated",
    "detect": {"type": "regex", "pattern": "each_item\\s*=\\s*True"},
    "replacement": "Annotate the list element type: list[Annotated[str, Field(...)]]"
  },
  {
    "id": "field-regex-removed",
    "title": "Field(regex=...) removed; use Field(pattern=...) instead",
    "kind": "api_removed",
    "guideSection": "Changes to pydantic.Field",
    "detect": {"type": "regex", "pattern": "Field\\(.*regex\\s*="},
    "replacement": "Field(..., pattern=r'...')"
  },
  {
    "id": "constr-regex-removed",
    "title": "constr(regex=...) removed; use Annotated[str, StringConstraints(pattern=...)] instead",
    "kind": "api_removed",
    "guideSection": "Constrained types",
    "detect": {"type": "regex", "pattern": "constr\\(.*regex\\s*="},
    "replacement": "Annotated[str, StringConstraints(pattern=r'...')]"
  },
  {
    "id": "optional-required-semantics",
    "title": "Optional[T] without a default is now required (no implicit default of None)",
    "kind": "behavior_changed",
    "guideSection": "Required, optional, and nullable fields",
    "detect": {"type": "regex", "pattern": ":\\s*Optional\\[\\w+\\]\\s*$"},
    "replacement": "Add = None if you want the field to be optional: field: Optional[str] = None"
  },
  {
    "id": "dict-method-renamed",
    "title": ".dict() renamed to .model_dump()",
    "kind": "api_changed",
    "guideSection": "Changes to pydantic.BaseModel",
    "detect": {"type": "call", "pattern": "\\.dict\\(\\)"},
    "replacement": ".model_dump()"
  },
  {
    "id": "json-method-renamed",
    "title": ".json() deprecated; use .model_dump_json()",
    "kind": "api_changed",
    "guideSection": "Changes to pydantic.BaseModel",
    "detect": {"type": "call", "pattern": "\\.json\\(\\)"},
    "replacement": ".model_dump_json()"
  },
  {
    "id": "parse-obj-renamed",
    "title": "parse_obj() renamed to model_validate()",
    "kind": "api_changed",
    "guideSection": "Changes to pydantic.BaseModel",
    "detect": {"type": "call", "pattern": "parse_obj"},
    "replacement": "Model.model_validate(data)"
  },
  {
    "id": "from-orm-deprecated",
    "title": "from_orm() deprecated; use model_validate() with from_attributes=True in model_config",
    "kind": "api_changed",
    "guideSection": "Changes to pydantic.BaseModel",
    "detect": {"type": "call", "pattern": "from_orm"},
    "replacement": "Model.model_validate(obj) with model_config = ConfigDict(from_attributes=True)"
  },
  {
    "id": "constrained-types-removed",
    "title": "ConstrainedInt, ConstrainedStr, etc. removed; use Annotated[type, Field(...)] instead",
    "kind": "api_removed",
    "guideSection": "Constrained types",
    "detect": {"type": "regex", "pattern": "Constrained(Int|Str|Float|Decimal|Bytes|List|Set|FrozenSet|Date)"},
    "replacement": "Annotated[int, Field(ge=0)] or Annotated[str, StringConstraints(...)]"
  }
]
