[
  {
    "id": "basesettings-moved",
    "title": "BaseSettings moved to pydantic-settings package",
    "kind": "api_removed",
    "guideSection": "BaseSettings has moved to pydantic-settings",
    "detect": {
      "type": "import",
      "pattern": "from pydantic import BaseSettings"
    },
    "replacement": "from pydantic_settings import BaseSettings  # pip install pydantic-settings"
  },
  {
    "id": "orm-mode-renamed",
    "title": "Config orm_mode renamed to from_attributes",
    "kind": "api_changed",
    "guideSection": "Changes to config",
    "detect": {
      "type": "regex",
      "pattern": "orm_mode\\s*=\\s*True"
    },
    "replacement": "model_config = ConfigDict(from_attributes=True)"
  },
  {
    "id": "config-class-deprecated",
    "title": "Inner class Config deprecated; use model_config = ConfigDict(...) instead",
    "kind": "syntax",
    "guideSection": "Changes to config",
    "detect": {
      "type": "regex",
      "pattern": "class Config:"
    },
    "replacement": "model_config = ConfigDict(...)"
  },
  {
    "id": "validator-deprecated",
    "title": "@validator deprecated; replace with @field_validator",
    "kind": "api_changed",
    "guideSection": "@validator and @root_validator are deprecated",
    "detect": {
      "type": "regex",
      "pattern": "from pydantic import.*\\bvalidator\\b"
    },
    "replacement": "from pydantic import field_validator"
  },
  {
    "id": "validator-decorator",
    "title": "@validator decorator usage must migrate to @field_validator",
    "kind": "api_changed",
    "guideSection": "@validator and @root_validator are deprecated",
    "detect": {
      "type": "regex",
      "pattern": "@validator\\("
    },
    "replacement": "@field_validator(..., mode='before')"
  },
  {
    "id": "field-regex-renamed",
    "title": "Field(regex=...) renamed to Field(pattern=...)",
    "kind": "api_changed",
    "guideSection": "Changes to pydantic.Field",
    "detect": {
      "type": "regex",
      "pattern": "Field\\([^)]*regex\\s*="
    },
    "replacement": "Field(..., pattern=...)"
  },
  {
    "id": "constr-removed",
    "title": "constr() constrained type removed; use Annotated[str, StringConstraints(...)]",
    "kind": "api_removed",
    "guideSection": "Constrained types",
    "detect": {
      "type": "regex",
      "pattern": "constr\\("
    },
    "replacement": "Annotated[str, StringConstraints(pattern=...)]"
  },
  {
    "id": "from-orm-deprecated",
    "title": "Model.from_orm() deprecated; use Model.model_validate(obj) with from_attributes=True",
    "kind": "api_changed",
    "guideSection": "Changes to pydantic.BaseModel",
    "detect": {
      "type": "regex",
      "pattern": "\\.from_orm\\("
    },
    "replacement": "Model.model_validate(obj)"
  },
  {
    "id": "optional-field-semantics",
    "title": "Optional[T] fields are now required (no implicit default of None)",
    "kind": "behavior_changed",
    "guideSection": "Required, optional, and nullable fields",
    "detect": {
      "type": "regex",
      "pattern": ":\\s*Optional\\[.*\\](?!\\s*=)"
    },
    "replacement": "Add explicit default: field: Optional[T] = None if not required"
  },
  {
    "id": "dict-method-deprecated",
    "title": ".dict() method deprecated; use .model_dump()",
    "kind": "api_changed",
    "guideSection": "Changes to pydantic.BaseModel",
    "detect": {
      "type": "regex",
      "pattern": "\\.dict\\(\\)"
    },
    "replacement": ".model_dump()"
  },
  {
    "id": "parse-obj-deprecated",
    "title": ".parse_obj() deprecated; use .model_validate()",
    "kind": "api_changed",
    "guideSection": "Changes to pydantic.BaseModel",
    "detect": {
      "type": "regex",
      "pattern": "\\.parse_obj\\("
    },
    "replacement": ".model_validate(...)"
  },
  {
    "id": "root-validator-deprecated",
    "title": "@root_validator deprecated; replace with @model_validator",
    "kind": "api_changed",
    "guideSection": "@validator and @root_validator are deprecated",
    "detect": {
      "type": "regex",
      "pattern": "@root_validator"
    },
    "replacement": "@model_validator(mode='before') or mode='after'"
  },
  {
    "id": "constrained-types-import",
    "title": "Constrained* classes (ConstrainedInt, ConstrainedStr, etc.) removed",
    "kind": "api_removed",
    "guideSection": "Constrained types",
    "detect": {
      "type": "regex",
      "pattern": "from pydantic import.*Constrained"
    },
    "replacement": "Use Annotated[type, Field(...)] with constraints"
  }
]
